<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qmd.qmd-mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/qmd</string>
    <string>mcp</string>
    <string>--http</string>
    <string>--port</string>
    <string>8181</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>QMD_ALLOWED_ORIGINS</key><string>*</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>StandardOutPath</key><string>/tmp/qmd-mcp.log</string>
  <key>StandardErrorPath</key><string>/tmp/qmd-mcp.err</string>
</dict>
</plist>
